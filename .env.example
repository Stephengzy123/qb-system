# PostgreSQL / Neon
DATABASE_URL=

# Authentication
AUTH_SECRET=
# Username that receives administrator access automatically on first sign-in
INITIAL_ADMIN_USERNAME=
# Optional canonical app URL, e.g. https://qb.example.com
BETTER_AUTH_URL=

# Cloudflare R2 private storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Upload and retention defaults
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=40000000
STAGING_RETENTION_HOURS=24
UNREFERENCED_ASSET_RETENTION_DAYS=7
ORIGINAL_UPLOAD_RETENTION_DAYS=30
